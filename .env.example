# ---------------------------------------------------------------------------
# Database  (Neon, Supabase, or any Postgres)
# ---------------------------------------------------------------------------
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (non-pooled) connection used for migrations. Neon/Supabase give you both.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Auth.js
# ---------------------------------------------------------------------------
# Generate with:  openssl rand -base64 32
AUTH_SECRET=""
# Full public URL of the deployed app. Vercel sets this automatically in prod.
AUTH_URL="http://localhost:3000"
# Set to true only behind a proxy/Vercel.
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# Email (Resend) - powers magic-link sign in and notifications
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="PATH <implementations@yourdomain.com>"

# ---------------------------------------------------------------------------
# Google SSO for internal staff (optional but recommended)
# ---------------------------------------------------------------------------
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Comma-separated email domains that are auto-treated as internal staff.
INTERNAL_EMAIL_DOMAINS="pimsyehr.com"

# ---------------------------------------------------------------------------
# Bootstrapping
# ---------------------------------------------------------------------------
# Email address that gets OWNER role on first sign-in. Set this to yours.
BOOTSTRAP_OWNER_EMAIL="alexander@pimsyehr.com"

# ---------------------------------------------------------------------------
# File uploads. Optional - leave both blank to store files on local disk
# (fine for local dev; on Azure App Service or Container Apps, local disk
# isn't reliably persistent, so set AZURE_STORAGE_CONNECTION_STRING there).
# ---------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER="pimsy-uploads"

# ---------------------------------------------------------------------------
# Prism cutover (v1.11) — import + Director snapshot API
# ---------------------------------------------------------------------------
# One-time dump only. Copy SQL_CONNECTION_STRING from the Prism Static Web App
# (nice-rock / purple-beach). Do not invent credentials. Not used at runtime.
# PRISM_SQL_CONNECTION_STRING=""
#
# Bearer token for GET /api/prism/snapshot and GET /api/go (Power Automate).
# Generate with: openssl rand -base64 32
# Leave blank to allow signed-in sessions only (snapshot: OWNER/ADMIN/MANAGER;
# /api/go: any signed-in user, that user's destination only).
# PRISM_READ_API_KEY=""

# ---------------------------------------------------------------------------
# Dock account logos (one-time import only — not used by the running app)
# ---------------------------------------------------------------------------
# Secret key from the PIMSY Dock workspace (https://pimsyehr.dock.us):
# Settings → API → Create new secret key. Account admin. Shown once.
# Dry-run:  npm run db:import:dock-logos
# Apply:    npm run db:import:dock-logos -- --apply
# Matches PATH customers by acronym. Does not call HubSpot.
# DOCK_API_KEY=""
# DOCK_API_BASE="https://api.dock.us"
# Or skip the API and pass a JSON snapshot: npm run db:import:dock-logos -- ./dock-logos.json

# ---------------------------------------------------------------------------
# HubSpot (optional) — read-only deal pull
# ---------------------------------------------------------------------------
# Private app token with crm.objects.deals.read only. PATH GETs
# /crm/v3/objects/deals/{id}. It never creates, updates, or deletes HubSpot
# records, and it does not call the search endpoint (that API is a POST).
# When unset, New project / Add to roster / About still store a clear
# outbound deal URL and do not block save. Never sent to the customer portal.
# HUBSPOT_ACCESS_TOKEN=""
#
# CEO field mapping. Defaults are standard HubSpot deal properties.
# Contract date → projects.contractDate from closedate (midnight UTC).
# Expected ARR → projects.expectedArr from amount.
# Set a custom internal name only if the portal uses one. Invalid names fall
# back to the defaults. A custom value wins; an empty custom value falls
# back to closedate / amount. PATH fills a CEO field only when it is empty.
# Clearing the deal URL does not wipe contract date or expected ARR.
# HUBSPOT_DEAL_CONTRACT_DATE_PROPERTY="closedate"
# HUBSPOT_DEAL_ARR_PROPERTY="amount"

# ---------------------------------------------------------------------------
# PIMSY EHR audit feed (optional) — “Confirm users have logged in”
# ---------------------------------------------------------------------------
# PATH does not store EHR audit rows and does not have EHR DB credentials in
# this repo. Until these are set, the training task shows PATH portal
# contacts only (last-seen = this app, not the EHR) and an empty session
# list. Do not paste sample users into production.
#
# GET {url}?siteKey={crmAcronym|prismClientId|code}&crmKey=&since=&windowDays=
# `{siteKey}` / `{crmKey}` in the path are substituted. Bearer token optional.
# Expected JSON: { "sessions": [{ "displayName", "username", "loggedInAt",
# "loggedOutAt", "durationSeconds" }] } — login/session events only.
# PIMSY_AUDIT_FEED_URL=""
# PIMSY_AUDIT_FEED_TOKEN=""
# PIMSY_AUDIT_FEED_WINDOW_DAYS="14"

# ---------------------------------------------------------------------------
# Cron (customer digest + assignee due reminders + Thursday account updates)
# ---------------------------------------------------------------------------
# Bearer token for POST/GET /api/cron/customer-digest (batched customer
# email; Azure Logic App every 15 minutes), /api/cron/task-due-reminders,
# and /api/cron/weekly-status-update-reminder (Thursday Imp Spec nag).
# Generate with: openssl rand -base64 32
# Leave blank and those routes 404.
# CRON_SECRET=""

# Bearer token for POST /api/internal/dock-delivery/ingest (Dock WIP analytics).
# Weekday Logic App or the CoS box posts dock-wip.json and dock-threads.json.
# PATH does not log in to Dock. Leave blank and the route 404s.
# Generate with: openssl rand -base64 32
# DOCK_DELIVERY_INGEST_SECRET=""

# Bearer token for POST /api/discovery-wizard/workbook (Power Automate delivering
# the Discovery Wizard Excel). Falls back to PRISM_READ_API_KEY when unset.
# DISCOVERY_WIZARD_WEBHOOK_SECRET=""
