# ---------------------------------------------------------------------------
# Database  (Neon, Supabase, or any Postgres)
# ---------------------------------------------------------------------------
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (non-pooled) connection used for migrations. Neon/Supabase give you both.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Auth.js
# ---------------------------------------------------------------------------
# Generate with:  openssl rand -base64 32
AUTH_SECRET=""
# Full public URL of the deployed app. Vercel sets this automatically in prod.
AUTH_URL="http://localhost:3000"
# Set to true only behind a proxy/Vercel.
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# Email (Resend) - powers magic-link sign in and notifications
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="PIMSY Implementations <implementations@yourdomain.com>"

# ---------------------------------------------------------------------------
# Google SSO for internal staff (optional but recommended)
# ---------------------------------------------------------------------------
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Comma-separated email domains that are auto-treated as internal staff.
INTERNAL_EMAIL_DOMAINS="pimsyehr.com"

# ---------------------------------------------------------------------------
# Bootstrapping
# ---------------------------------------------------------------------------
# Email address that gets OWNER role on first sign-in. Set this to yours.
BOOTSTRAP_OWNER_EMAIL="alexander@pimsyehr.com"

# ---------------------------------------------------------------------------
# File uploads. Optional - leave both blank to store files on local disk
# (fine for local dev; on Azure App Service or Container Apps, local disk
# isn't reliably persistent, so set AZURE_STORAGE_CONNECTION_STRING there).
# ---------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER="pimsy-uploads"
